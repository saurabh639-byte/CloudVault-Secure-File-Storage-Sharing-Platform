# Copy to .env.local for local dev overrides (Vite auto-loads it)

# Leave unset to use the Vite dev-server proxy (see vite.config.ts) which
# forwards /api and /ws to http://localhost:8000. Set explicitly for
# pointing at a deployed backend or a different port.
# The backend serves everything under /api/v1 - see backend/app/main.py.
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
